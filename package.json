{
  "name": "adm-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:sync": "tsx scripts/content-sync.ts",
    "check:content": "tsx scripts/check-consistency.ts",
    "prebuild": "npm run content:sync && npm run check:content",
    "build": "vite build && tsx scripts/check-consistency.ts --dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:playthrough": "playwright test tests/playthrough.spec.ts",
    "test:e2e": "playwright test",
    "zone:gen": "tsx scripts/zone-gen.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1"
  }
}
